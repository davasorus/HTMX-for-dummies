<!-- views/partials/todo-item.ejs -->
<li id="todo-<%= todo.id %>">
  <form
    class="group flex items-center gap-3 rounded-lg border border-zinc-800 bg-zinc-900 px-3 py-2"
    hx-put="/todos/<%= todo.id %>"
    hx-target="#todo-<%= todo.id %>"
    hx-swap="outerHTML"
    hx-on:change="this.requestSubmit()"
  >
    <input
      type="checkbox"
      id="todo-item-<%= todo.id %>"
      name="completed"
      class="size-4 accent-emerald-500"
      <%= todo.completed ? 'checked' : '' %>
    />
    <input type="hidden" name="task" value="<%= todo.task %>" />
    <label
      for="todo-item-<%= todo.id %>"
      class="flex-1 cursor-pointer text-sm <%= todo.completed ? 'text-zinc-500 line-through' : 'text-zinc-100' %>"
    >
      <%= todo.task %>
    </label>
    <button
      type="button"
      class="rounded px-2 py-1 text-xs text-zinc-500 opacity-0 transition hover:bg-red-500/10 hover:text-red-400 group-hover:opacity-100"
      hx-delete="/todos/<%= todo.id %>"
      hx-target="#todo-list"
      hx-swap="outerHTML transition:true"
      hx-confirm="Are you sure you want to delete this task?"
    >
      Delete
    </button>
  </form>
</li>